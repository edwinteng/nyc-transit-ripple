# Copy to .env for local overrides. .env is gitignored; never commit secrets.
# Existing environment variables always take precedence over this file.

# Output directory for Parquet tables, reports and state.
# RIPPLE_DATA_DIR=data
# Static GTFS cache (default: <RIPPLE_DATA_DIR>/static).
# RIPPLE_STATIC_DIR=
# Static GTFS source (URL or local zip path) and refresh interval.
# RIPPLE_STATIC_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_supplemented.zip
# RIPPLE_STATIC_MAX_AGE_HOURS=6

# Data quality thresholds (see docs/data-model.md).
# RIPPLE_STALE_AFTER_S=180
# RIPPLE_FUTURE_TOLERANCE_S=60
# RIPPLE_MAX_LAG_S=7200
# RIPPLE_MAX_LEAD_S=14400
# RIPPLE_MIN_DELAY_MIN=-30
# RIPPLE_MAX_DELAY_MIN=240
# RIPPLE_DELAY_JUMP_TOLERANCE_MIN=15
# RIPPLE_NON_MONOTONIC_TOLERANCE_S=60
# RIPPLE_STALE_PREDICTION_TOLERANCE_S=120
# RIPPLE_VEHICLE_STALE_AFTER_S=600
# RIPPLE_DELAYED_THRESHOLD_MIN=5

# HTTP
# RIPPLE_HTTP_TIMEOUT_S=20

# Optional secret. The subway feeds need no key; if set, it is sent as x-api-key.
# MTA_API_KEY=
