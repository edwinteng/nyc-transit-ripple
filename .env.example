# Copy to .env for local overrides. .env is gitignored; never commit secrets.
# Existing environment variables always take precedence over this file.
# Every setting is RIPPLE_<FIELD_NAME> (see src/transit_ripple/config.py).

# --- storage -------------------------------------------------------------------------
# RIPPLE_DATA_DIR=data
# RIPPLE_STATIC_DIR=                       # default: <RIPPLE_DATA_DIR>/static
# RIPPLE_STATIC_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_supplemented.zip
# RIPPLE_STATIC_MAX_AGE_HOURS=6

# --- subway feed quality (M1) --------------------------------------------------------
# RIPPLE_STALE_AFTER_S=180
# RIPPLE_FUTURE_TOLERANCE_S=60
# RIPPLE_MAX_LAG_S=7200
# RIPPLE_MAX_LEAD_S=14400
# RIPPLE_MIN_DELAY_MIN=-30
# RIPPLE_MAX_DELAY_MIN=240
# RIPPLE_DELAY_JUMP_TOLERANCE_MIN=15
# RIPPLE_NON_MONOTONIC_TOLERANCE_S=60
# RIPPLE_STALE_PREDICTION_TOLERANCE_S=120
# RIPPLE_VEHICLE_STALE_AFTER_S=600
# RIPPLE_DELAYED_THRESHOLD_MIN=5

# --- other sources (M2) --------------------------------------------------------------
# RIPPLE_ALERTS_STALE_AFTER_S=21600        # header = time of last alert change
# RIPPLE_TRAFFIC_LOOKBACK_MIN=90
# RIPPLE_TRAFFIC_STALE_AFTER_S=1200
# RIPPLE_GBFS_URL=https://gbfs.citibikenyc.com/gbfs/gbfs.json
# RIPPLE_BIKE_FEED_STALE_AFTER_S=300
# RIPPLE_BIKE_STATION_STALE_AFTER_S=1800
# RIPPLE_BIKE_INFO_MAX_AGE_HOURS=24
# RIPPLE_BIKE_RETENTION_DAYS=35
# RIPPLE_SOURCE_GAP_MIN=15

# --- spatial join, baselines -----------------------------------------------------------
# RIPPLE_NEIGHBOR_RADIUS_M=500
# RIPPLE_BASELINE_DAYS=28
# RIPPLE_BASELINE_SLOT_MIN=30
# RIPPLE_BASELINE_MIN_DAYS=3
# RIPPLE_BASELINE_MAX_AGE_HOURS=24
# RIPPLE_BASELINE_EXCLUDE_RECENT_HOURS=24

# --- delay events ----------------------------------------------------------------------
# RIPPLE_EVENT_METRIC=delay_median_min     # or delay_mean_min, delay_p90_min, delay_max_min
# RIPPLE_EVENT_THRESHOLD_MIN=5
# RIPPLE_EVENT_MIN_MINUTES=5               # N consecutive minutes
# RIPPLE_EVENT_MIN_OBSERVED=2
# RIPPLE_EVENT_MIN_TRIPS=2
# RIPPLE_EVENT_FILL_MAX_AGE_MIN=5
# RIPPLE_EVENT_MAX_GAP_MIN=10
# RIPPLE_EVENT_LOOKBACK_HOURS=24
# RIPPLE_EVENT_CONTEXT_STATIONS=3
# RIPPLE_SURFACE_FILL_MAX_AGE_MIN=20

# --- cameras during events (M4) ------------------------------------------------------
# RIPPLE_EVENT_CAMERAS_ENABLED=true        # count cameras near ongoing events only
# RIPPLE_EVENT_CAMERA_MAX_PER_RUN=30       # hard cap per run (about 1 camera per second)
# RIPPLE_CAMERA_FILL_MAX_AGE_MIN=10

# --- surface impact score (M4; see docs/data-model.md) -------------------------------
# RIPPLE_IMPACT_WEIGHT_TRAFFIC=0.4         # weights are renormalized over usable signals
# RIPPLE_IMPACT_WEIGHT_CAMERA=0.3
# RIPPLE_IMPACT_WEIGHT_BIKES=0.3
# RIPPLE_IMPACT_TRAFFIC_FULL_DROP_PCT=40   # this speed drop vs. baseline scores 100
# RIPPLE_IMPACT_CAMERA_FULL_INCREASE_PCT=100
# RIPPLE_IMPACT_BIKES_FULL_DROP_PCT=30
# RIPPLE_IMPACT_MIN_CONFIDENCE=ok          # or low: also use baselines with little history
# RIPPLE_IMPACT_RECOVERY_THRESHOLD=20
# RIPPLE_IMPACT_RECOVERY_MINUTES=10
# RIPPLE_IMPACT_RECOVERY_WINDOW_MIN=120

# --- dashboard export (M4) -----------------------------------------------------------
# RIPPLE_EXPORT_WINDOW_DAYS=30
# RIPPLE_EXPORT_MAX_POINTS=120             # chart points per series in the browser

# --- site, HTTP ------------------------------------------------------------------------
# RIPPLE_SITE_MAX_EVENTS=30
# RIPPLE_SITE_CHART_PADDING_MIN=30
# RIPPLE_HTTP_TIMEOUT_S=20

# --- optional secrets (free; never logged) --------------------------------------------
# Free NYC Open Data app token for higher rate limits (sent only to data.cityofnewyork.us).
# SOCRATA_APP_TOKEN=
# Not needed by the subway feeds; if set, sent only to MTA endpoints as x-api-key.
# MTA_API_KEY=
